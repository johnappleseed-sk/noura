# ---------------------------
# Project / Ports
# ---------------------------
COMPOSE_PROJECT_NAME=noura-platform
GATEWAY_PORT=8080
APP_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
CATALOG_SERVICE_PORT=8084
SEARCH_SERVICE_PORT=8085
INVENTORY_SERVICE_PORT=8086
PRICING_SERVICE_PORT=8087
KEYCLOAK_PORT=18080
KAFKA_HOST_PORT=29092

# ---------------------------
# PostgreSQL (single cluster, multi-db)
# ---------------------------
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=postgres
POSTGRES_DEFAULT_DB=postgres
APP_DB_NAME=commerce_platform
APP_DB_USER=commerce
APP_DB_PASSWORD=commerce
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# ---------------------------
# Redis
# ---------------------------
REDIS_PORT=6379

# ---------------------------
# Kafka (KRaft single-node local)
# ---------------------------
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# ---------------------------
# Keycloak
# ---------------------------
KEYCLOAK_REALM=noura
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=adminadmin

# ---------------------------
# Gateway/Auth
# ---------------------------
GATEWAY_AUTH_ENABLED=false
GATEWAY_FORWARD_CLAIMS=true

# ---------------------------
# App Service
# ---------------------------
APP_JWT_SECRET=dev-super-secret-change-me-please-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ---------------------------
# Notification extraction bridge
# ---------------------------
APP_NOTIFICATIONS_REMOTE_ENABLED=true
APP_NOTIFICATIONS_REMOTE_BASE_URL=http://notification-service:8080
APP_NOTIFICATIONS_REMOTE_COMMAND_PATH=/internal/notifications
APP_NOTIFICATIONS_REMOTE_FALLBACK_LOCAL=true
NOTIFICATION_INTERNAL_API_KEY=
